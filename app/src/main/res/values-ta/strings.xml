    <!-- Onboarding screens -->
    <string name="location_services_required">இருப்பிட சேவைகள் தேவை</string>
    <string name="privacy_first">தனியுரிமை முதல்</string>
    <string name="location_explanation">Vuzol உங்கள் இருப்பிடத்தை கண்காணிக்காது.\n\nBluetooth scanning மற்றும் Geohash அரட்டை அம்சத்திற்கு இருப்பிட சேவைகள் தேவை.</string>
    <string name="location_needs_for">Vuzol-க்கு இருப்பிட சேவைகள் தேவை:</string>
    <string name="location_needs_bullets">• Bluetooth சாதன scanning\n• mesh நெட்வொர்க்கில் அருகிலுள்ள பயனர்களை கண்டுபிடிக்க\n• Geohash அரட்டை அம்சம்\n• கண்காணிப்பு அல்லது இருப்பிட சேகரிப்பு இல்லை</string>
    <string name="background_location_required_title">பின்னணி இருப்பிடம் பரிந்துரைக்கப்படுகிறது</string>
    <string name="background_location_required_subtitle">விருப்பமானது, mesh நம்பகத்தன்மையை மேம்படுத்துகிறது</string>
    <string name="background_location_explanation">பயன்பாடு திறக்கப்படாத போது Vuzol அருகிலுள்ள சாதனங்களை ஸ்கேன் செய்ய Android பின்னணி இருப்பிடத்தை பரிந்துரைக்கிறது. இது மறுதொடக்கத்திற்குப் பிறகும் mesh இயங்குவதை வைத்திருக்கிறது.</string>
    <string name="background_location_settings_tip">அமைப்புகள் திறக்கும்போது, "எப்பொழுதும் அனுமதி" என்பதை தேர்ந்தெடுங்கள்.</string>
    <string name="background_location_needs_for">Vuzol பின்னணி இருப்பிடத்தைப் பயன்படுத்துகிறது:</string>
    <string name="background_location_needs_bullets">- பயன்பாடு மூடப்படும்போது அருகிலுள்ள சாதனங்களை ஸ்கேன் செய்ய\n- மறுதொடக்கத்திற்குப் பிறகு மீண்டும் இணைக்க\n- பின்னணியில் mesh இயங்குவதை தொடர</string>
    <string name="background_location_privacy_note">நாங்கள் உங்கள் இருப்பிடத்தை ஒருபோதும் சேகரிக்கவோ சேமிக்கவோ மாட்டோம். உங்கள் தனியுரிமை பாதுகாப்பானது.</string>
    <string name="grant_background_location">பின்னணி இருப்பிடத்தை அனுமதி</string>
    <string name="skip_background_location">பின்னணி இருப்பிடம் இல்லாமல் தொடரவும்</string>
    <string name="open_location_settings">இருப்பிட அமைப்புகளை திற</string>
    <string name="check_again">மீண்டும் சரிபார்க்கவும்</string>
    <string name="location_services_unavailable">இருப்பிட சேவைகள் கிடைக்கவில்லை</string>
    <string name="location_unavailable_explanation">இந்த சாதனத்தில் இருப்பிட சேவைகள் கிடைக்கவில்லை. Android சாதனங்களில் இருப்பிட சேவைகள் நிலையானதாக இருப்பதால் இது அசாதாரணமானது.\n\nVuzol-க்கு Bluetooth scanning சரியாக வேலை செய்ய இருப்பிட சேவைகள் தேவை (Android தேவை). இல்லாமல், பயன்பாடு அருகிலுள்ள பயனர்களை கண்டுபிடிக்க முடியாது.</string>
    <string name="checking_location_services">இருப்பிட சேவைகள் சரிபார்க்கிறது...</string>
    <string name="bluetooth_required">Bluetooth தேவை</string>
    <string name="bluetooth_needs_for">Vuzol-க்கு Bluetooth தேவை:</string>
    <string name="bluetooth_needs_bullets">• அருகிலுள்ள பயனர்களை கண்டுபிடிக்க\n• mesh நெட்வொர்க் இணைப்புகளை உருவாக்க\n• செய்திகளை அனுப்பவும் பெறவும்\n• இணையம் அல்லது சர்வர்கள் இல்லாமல் வேலை செய்ய</string>
    <string name="enable_bluetooth">Bluetooth இயக்கு</string>
    <string name="bluetooth_not_supported">Bluetooth ஆதரிக்கப்படவில்லை</string>
    <string name="bluetooth_unsupported_explanation">இந்த சாதனம் Bluetooth Low Energy (BLE) ஆதரிக்கவில்லை, இது Vuzol செயல்பட தேவை.\n\nVuzol-க்கு mesh நெட்வொர்க்குகளை உருவாக்கவும் இணையம் இல்லாமல் அருகிலுள்ள சாதனங்களுடன் தொடர்பு கொள்ளவும் BLE தேவை.</string>
