    <string name="skip_background_location">Kontynuuj bez lokalizacji w tle</string>
    <string name="open_location_settings">Otwórz ustawienia lokalizacji</string>
    <string name="check_again">Sprawdź ponownie</string>
    <string name="location_services_unavailable">Usługi lokalizacyjne niedostępne</string>
    <string name="location_unavailable_explanation">Usługi lokalizacyjne nie są dostępne na tym urządzeniu. Jest to niezwykłe, ponieważ usługi lokalizacyjne są standardem na urządzeniach z Androidem.\n\nVuzol potrzebuje usług lokalizacyjnych, aby skanowanie Bluetooth działało poprawnie (wymóg Androida). Bez tego aplikacja nie może wykrywać pobliskich użytkowników.</string>
    <string name="checking_location_services">Sprawdzanie usług lokalizacyjnych...</string>
    <string name="bluetooth_required">Bluetooth wymagany</string>
    <string name="bluetooth_needs_for">Vuzol potrzebuje Bluetooth do:</string>
    <string name="bluetooth_needs_bullets">• Wykrywania pobliskich użytkowników\n• Tworzenia połączeń sieciowych mesh\n• Wysyłania i odbierania wiadomości\n• Działania bez internetu i serwerów</string>
    <string name="enable_bluetooth">Włącz Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth nieobsługiwany</string>
    <string name="bluetooth_unsupported_explanation">To urządzenie nie obsługuje Bluetooth Low Energy (BLE), które jest wymagane do działania Vuzol.\n\nVuzol potrzebuje BLE do tworzenia sieci mesh i komunikacji z pobliskimi urządzeniami bez internetu.</string>
