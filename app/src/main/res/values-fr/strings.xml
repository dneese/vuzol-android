    <string name="battery_optimization_detected_title">optimisation de la batterie détectée</string>
    <string name="battery_optimization_enabled_title">Optimisation de la batterie activée</string>
    <string name="battery_optimization_explanation_short">Vuzol doit fonctionner en arrière-plan pour maintenir les connexions mesh. l\'optimisation de la batterie peut les interrompre.</string>
