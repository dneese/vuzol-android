    <string name="bluetooth_required">Bluetooth requis</string>
    <string name="bluetooth_needs_for">Vuzol a besoin de Bluetooth pour :</string>
    <string name="bluetooth_needs_bullets">• Découvrir les utilisateurs à proximité\n• Créer des connexions de réseau mesh\n• Envoyer et recevoir des messages\n• Fonctionner sans internet ni serveurs</string>
    <string name="enable_bluetooth">Activer Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth non pris en charge</string>
    <string name="bluetooth_unsupported_explanation">Cet appareil ne prend pas en charge Bluetooth Low Energy (BLE), requis pour le fonctionnement de Vuzol.\n\nVuzol a besoin de BLE pour créer des réseaux mesh et communiquer sans internet avec les appareils à proximité.</string>
