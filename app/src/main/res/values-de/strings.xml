    <string name="location_services_required">Standortdienste erforderlich</string>
    <string name="privacy_first">Privatsphäre zuerst</string>
    <string name="location_explanation">Vuzol verfolgt NICHT deinen Standort.\n\nStandortdienste sind für Bluetooth-Scanning und das Geohash-Chat-Feature erforderlich.</string>
    <string name="location_needs_for">Vuzol benötigt Standortdienste für:</string>
    <string name="location_needs_bullets">• Bluetooth-Gerätescanning\n• Entdecken nahegelegener Benutzer im Mesh-Netzwerk\n• Geohash-Chat-Feature\n• Keine Verfolgung oder Standortsammlung</string>
    <string name="background_location_required_title">Hintergrundstandort empfohlen</string>
    <string name="background_location_required_subtitle">optional, verbessert die Mesh-Zuverlässigkeit</string>
    <string name="background_location_explanation">Android empfiehlt den Hintergrundstandort, damit Vuzol nach Geräten in der Nähe suchen kann, wenn die App nicht geöffnet ist. Dadurch bleibt das Mesh nach einem Neustart aktiv.</string>
    <string name="background_location_settings_tip">Wenn die Einstellungen geöffnet werden, wähle „Immer zulassen".</string>
    <string name="background_location_needs_for">Vuzol verwendet den Hintergrundstandort für:</string>
    <string name="background_location_needs_bullets">- Suche nach Geräten in der Nähe, wenn die App geschlossen ist\n- Erneutes Verbinden nach einem Neustart\n- Mesh im Hintergrund aktiv halten</string>
    <string name="background_location_privacy_note">Wir erfassen oder speichern deinen Standort NIEMALS. Deine Privatsphäre ist sicher.</string>
    <string name="grant_background_location">Hintergrundstandort erlauben</string>
    <string name="skip_background_location">Ohne Hintergrundstandort fortfahren</string>
    <string name="open_location_settings">Standorteinstellungen öffnen</string>
    <string name="check_again">Erneut prüfen</string>
    <string name="location_services_unavailable">Standortdienste nicht verfügbar</string>
    <string name="location_unavailable_explanation">Standortdienste sind auf diesem Gerät nicht verfügbar. Das ist ungewöhnlich, da Standortdienste bei Android-Geräten Standard sind.\n\nVuzol benötigt Standortdienste für das ordnungsgemäße Funktionieren des Bluetooth-Scannings (Android-Anforderung). Ohne diese kann die App keine nahegelegenen Benutzer entdecken.</string>
    <string name="checking_location_services">Standortdienste werden geprüft …</string>
    <string name="bluetooth_required">Bluetooth erforderlich</string>
    <string name="bluetooth_needs_for">Vuzol benötigt Bluetooth für:</string>
    <string name="bluetooth_needs_bullets">• Entdecken nahegelegener Benutzer\n• Erstellen von Mesh-Netzwerkverbindungen\n• Senden und Empfangen von Nachrichten\n• Funktionieren ohne Internet oder Server</string>
    <string name="enable_bluetooth">Bluetooth aktivieren</string>
    <string name="bluetooth_not_supported">Bluetooth nicht unterstützt</string>
    <string name="bluetooth_unsupported_explanation">Dieses Gerät unterstützt kein Bluetooth Low Energy (BLE), das für das Funktionieren von Vuzol erforderlich ist.\n\nVuzol benötigt BLE, um Mesh-Netzwerke zu erstellen und ohne Internet mit nahegelegenen Geräten zu kommunizieren.</string>
    <string name="checking_bluetooth_status">Bluetooth-Status wird geprüft …</string>
    <string name="battery_optimization_detected_title">Akku-Optimierung erkannt</string>
    <string name="battery_optimization_enabled_title">Akku-Optimierung aktiviert</string>
    <string name="battery_optimization_explanation_short">Vuzol muss im Hintergrund laufen, um Mesh-Verbindungen aufrechtzuerhalten. Die Akku-Optimierung kann diese Verbindungen unterbrechen.</string>
    <string name="benefits_of_disabling">Vorteile der Deaktivierung</string>
    <string name="battery_benefits_short">• zuverlässige Nachrichtenzustellung\n• Aufrechterhaltung der Mesh-Konnektivität\n• verhindert Verbindungsabbrüche</string>
    <string name="disable_battery_optimization">Akku-Optimierung deaktivieren</string>
    <string name="battery_optimization_disabled_title">Akku-Optimierung deaktiviert</string>
